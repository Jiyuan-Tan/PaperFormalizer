    (hKc : 0 ≤ Kc) (hKb : 0 ≤ Kb) (hq₁ : 0 ≤ q₁) (hq₂ : 0 ≤ q₂) (hq₃ : 0 ≤ q₃)
    (hq₄ : 0 ≤ q₄) (he₃a : 0 ≤ e₃a) (he₃b : 0 ≤ e₃b) (he₄ : 0 ≤ e₄)
    (hC₂ : 0 ≤ C₂) (hC₃ : 0 ≤ C₃) :
