{
  "name": "paperformalizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "paperformalizer": "./bin/paperformalizer.ts"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint:template && npm test",
    "typecheck": "tsc --noEmit",
    "lint:module-headers": "tsx bin/lint_module_headers.ts",
    "lint:template": "tsx bin/lint_module_headers.ts --strict --paths ../templates/toolkit/Toolkit ../templates/toolkit/Toolkit.lean ../templates/toolkit/Papers.lean",
    "lint:layout": "tsx bin/lint_toolkit_layout.ts",
    "test": "vitest run",
    "search": "node --import tsx/esm bin/search.ts"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "katex": "^0.16.11",
    "mathjax-full": "^3.2.2",
    "pdfjs-dist": "^4.10.38",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "smol-toml": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.20.2"
  }
}
